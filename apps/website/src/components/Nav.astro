---
import Logo from "./Logo.astro";

const here = Astro.url.pathname.replace(/\/$/, "") || "/";

const links = [
  {
    href: "/docs/",
    label: "DOCS",
    match: (p: string) => p.startsWith("/docs"),
  },
];
---

<header class="container header">
  <div class="nav">
    <a class="brand" href="/" aria-label="tok0 home">
      <Logo class="brand-mark" />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <div class="nav-cta" data-nav-menu>
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.match(here) ? "true" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a
        class="gh"
        href="https://github.com/prxm-labs/tok0"
        target="_blank"
        rel="noopener"
        aria-label="tok0 on GitHub"
      >
        <svg
          class="gh-icon"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          aria-hidden="true"
        >
          <path
            fill="currentColor"
            fill-rule="evenodd"
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span>GITHUB</span>
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-nav-menu]");
  if (btn && menu) {
    btn.addEventListener("click", () => {
      const open = menu.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      btn.classList.toggle("open", open);
      document.body.classList.toggle("nav-locked", open);
    });
    // close menu when clicking any link
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        menu.classList.remove("open");
        btn.classList.remove("open");
        btn.setAttribute("aria-expanded", "false");
        document.body.classList.remove("nav-locked");
      }),
    );
  }
</script>
